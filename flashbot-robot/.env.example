# Aurobox Flashbot environment configuration example

# Pudu Robot API
Pd_key=YOUR_PUDU_API_KEY
Pd_secret=YOUR_PUDU_API_SECRET
Aurotek_id=YOUR_SHOP_ID
FLASHBOT_SN=ROBOT_SERIAL_NUMBER
DEFAULT_MAP_NAME=""
HOME_POINT_NAME=
CHARGE_POINT_NAME=
DOOR_MODE=4_DOORS
DOOR_MAPPING='{"H_01": ["H_01"], "H_02": ["H_02"], "H_03": ["H_03"], "H_04": ["H_04"]}'
CENTRAL_API_BASE_URL=

# Server Configuration
FLASK_ENV=development
FLASK_DEBUG=False
SERVER_HOST=127.0.0.1
SERVER_PORT=5000

# postgresql://帳號:密碼@主機位址:通訊埠/資料庫名稱
DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/aurobox_db
