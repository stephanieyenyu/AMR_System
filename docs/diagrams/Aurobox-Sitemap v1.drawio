        <mxCell id="note2" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fbfbf5;strokeColor=#b8b39a;fontSize=10;size=14;align=left;" value="主頁面右上角有「重新整理」，且四個葉面都有導覽列，任一頁可直接切到其他三頁。" vertex="1">
          <mxGeometry height="58" width="250" x="1360" y="196" as="geometry" />
