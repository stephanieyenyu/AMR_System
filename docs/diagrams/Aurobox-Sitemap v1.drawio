        <mxCell id="note1" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fbfbf5;strokeColor=#b8b39a;fontSize=10;size=14;align=left;" value="&lt;b&gt;四個管理頁共用&lt;/b&gt;&lt;br&gt;_base.html（頁首、樣式引入）&lt;br&gt;_nav.html（導覽列，四頁互相連通）&lt;br&gt;base.css、common.js" vertex="1">
