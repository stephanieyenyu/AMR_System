        </mxCell>
        <mxCell id="S6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;arcSize=8;" value="&lt;b&gt;包裹狀態統計&lt;/b&gt;　當日各狀態筆數" vertex="1">
