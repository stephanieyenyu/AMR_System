<mxfile host="app.diagrams.net">
  <diagram name="第 1 页" id="oYswKIEb-8iPYebsNZtL">
    <mxGraphModel dx="4760" dy="2485" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% 定義全局樣式\n    classDef state fill:#f7f9fc,stroke:#333,stroke-width:2px,color:#000\n    classDef note fill:#fff5ad,stroke:#d4c374,stroke-width:1px,stroke-dasharray: 5 5,color:#333\n\n    %% 1. 定義起始點與機器人實體狀態 (圓角矩形)\n    Start((( )))\n    style Start fill:#000,stroke:#000\n    \n    Idle([\&quot;idle&lt;br&gt;管理室待命中\&quot;]):::state\n    Assign_Return([\&quot;assign_return&lt;br&gt;回管理室接收任務&lt;br&gt;送貨時開啟艙門\&quot;]):::state\n    Moving([\&quot;moving&lt;br&gt;移動中\&quot;]):::state\n    Dispatch([\&quot;dispatch&lt;br&gt;全部派送&lt;br&gt;關閉艙門\&quot;]):::state\n    Arrived([\&quot;arrived&lt;br&gt;已抵達座標&lt;br&gt;顯示QR CODE\&quot;]):::state\n    DoorOpen([\&quot;door_open&lt;br&gt;艙門已開啟\&quot;]):::state\n    RemoveQR([\&quot;romove_qr&lt;br&gt;消除QR CODE\&quot;]):::state\n    WaitingUser([\&quot;waiting_user&lt;br&gt;等待住戶操作\&quot;]):::state\n    DoorClose([\&quot;door_close&lt;br&gt;艙門已關閉\&quot;]):::state\n    Returning([\&quot;returning&lt;br&gt;返航\&quot;]):::state\n    Return_Open([\&quot;return_open&lt;br&gt;返航開門檢查\&quot;]):::state\n    Return_Close([\&quot;return_close&lt;br&gt;檢查完關門\&quot;]):::state\n    Stuck([\&quot;stuck&lt;br&gt;無法移動\&quot;]):::state\n    Charging([\&quot;charging&lt;br&gt;充電中\&quot;]):::state\n\n    %% 2. 機器人主流程連線\n    Start --&gt; Idle\n    Idle --&gt;|\&quot;管理員分配艙門\&quot;| Assign_Return\n\n    Assign_Return --&gt;|\&quot;派送多個任務\&quot;| Assign_Return\n    Assign_Return --&gt;|\&quot;任務派送後全部配送\&quot;| Dispatch\n    \n    Idle --&gt;|\&quot;返回後管理員開門檢查\&quot;| Return_Open\n    Return_Open --&gt;|\&quot;拿出遺留的包裹\&quot;| Return_Close\n    Return_Close --&gt;|\&quot;檢查結束後關閉艙門\&quot;| Idle\n    \n    Dispatch --&gt;|\&quot;移動到任務地點\&quot;| Moving\n    Moving --&gt;|\&quot;抵達指定門牌座標\&quot;| Arrived\n    Moving --&gt;|\&quot;遇到障礙物 / 迷失方向\&quot;| Stuck\n    Arrived --&gt;|\&quot;住戶掃碼成功\&quot;| DoorOpen\n    DoorOpen --&gt;|\&quot;艙門釋放\&quot;| WaitingUser\n    Arrived --&gt;|\&quot;超過8分鐘無動作&lt;br&gt;或住戶選擇拒收\&quot;| RemoveQR\n    WaitingUser --&gt;|\&quot;住戶完成放入/取出 &lt;br&gt; 或系統判定逾時\&quot;| DoorClose\n    DoorClose --&gt;|\&quot;尚有其他任務\&quot;| Moving\n    DoorClose --&gt;|\&quot;所有任務結束，返回管理室\&quot;| Returning\n    RemoveQR --&gt;|\&quot;尚有其他任務\&quot;| Moving\n    RemoveQR --&gt;|\&quot;所有任務結束，返回管理室\&quot;| Returning\n    Returning --&gt;|\&quot;機器人返回管理室\&quot;| Idle\n    Returning --&gt;|\&quot;遇到障礙物 / 迷失方向\&quot;| Stuck\n    Idle --&gt;|\&quot;艙門全空時&lt;br&gt;可呼叫前往充電站\&quot;| Charging\n    Charging --&gt;|\&quot;管理員分配艙門\&quot;| Assign_Return\n    \n    Stuck --&gt;|\&quot;管理員重置機器人&lt;br&gt;手動推回管理室\&quot;| Idle\n    Stuck --&gt;|\&quot;手動排除障礙&lt;br&gt;繼續進行任務\&quot;| Moving\n    Moving --&gt;|\&quot;管理員強制召回\&quot;| Returning\n\n    %% 3. 備註區塊與虛線相連\n    Note_Return_Close[\&quot;所有艙門轉為empty\&quot;]:::note\n    Note_Arrived[\&quot;此時機器人不允許移動&lt;br&gt;不中斷取/放貨\&quot;]:::note\n    Note_Assign_Return[\&quot;所有被選取的艙門轉為assign&lt;br&gt;送貨的艙門開啟後轉為loading\&quot;]:::note\n    Note_Dispatch[\&quot;放入貨物的艙門轉為full&lt;br&gt;等待退貨的艙門維持assign\&quot;]:::note\n    Note_DoorOpen[\&quot;正在取貨的艙門轉為picking&lt;br&gt;正在退貨的艙門轉為putting\&quot;]:::note\n    Note_RemoveQR[\&quot;等待取貨的艙門維持full&lt;br&gt;等待退貨的艙門轉為empty\&quot;]:::note\n    Note_DoorClose[\&quot;取貨完成的艙門轉為empty&lt;br&gt;退貨完成的艙門轉為full\&quot;]:::note\n    \n\n    %% 將備註與對應的狀態節點掛鉤\n    Assign_Return -.- Note_Assign_Return\n    Dispatch -.- Note_Dispatch\n    Arrived -.- Note_Arrived\n    DoorOpen -.- Note_DoorOpen\n    RemoveQR -.- Note_RemoveQR\n    DoorClose -.- Note_DoorClose\n    Return_Close -.- Note_Return_Close&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Nu7ANZGfRiXXNqxukv-z-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
